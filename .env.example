# KYUBI Vercel Webhook — Variables d'environnement
# À renseigner dans Vercel Dashboard → Settings → Environment Variables

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# HMAC (doit être IDENTIQUE à HMAC_SECRET dans KYUBI/.env)
HMAC_SECRET=kyubi-super-secret-key-changez-ceci

# Resend (email gratuit jusqu'à 100/jour)
# Créer compte sur https://resend.com
RESEND_API_KEY=re_...

# Email expéditeur (doit être un domaine vérifié sur Resend)
FROM_EMAIL=KYUBI <noreply@votre-domaine.com>
